# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars and sensitive files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Environment files and secrets
.env
.env.*
*.env
*.secret
*.pem
*.key
*.token
!.env.example
!*.env.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Python cache & test files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.DS_Store
